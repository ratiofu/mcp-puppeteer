{
  "name": "@ratiofu/mcp-puppeteer",
  "version": "1.0.0",
  "description": "MCP server for controlling Chrome via Puppeteer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratiofu/mcp-puppeteer.git"
  },
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "mcp-puppeteer": "bin/mcp-puppeteer"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "pnpm run typecheck && rm -rf dist && node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:npx": "./test/test-npx.sh",
    "remote:publish": "./scripts/remote-publish.sh",
    "local:publish": "./scripts/local-publish.sh",
    "local:cleanup": "./scripts/local-cleanup.sh",
    "dev": "concurrently \"node esbuild.config.js --watch\" \"nodemon --watch dist --exec 'node dist/index.js' dist/index.js\"",
    "dev:inspector": "concurrently \"node esbuild.config.js --watch\" \"nodemon --watch dist --delay 2 --exec 'pnpm run restart-inspector' dist/index.js\"",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "restart-inspector": "pkill -f '@modelcontextprotocol/inspector' || true && sleep 1 && pnpm run inspector &",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "puppeteer",
    "chrome",
    "browser",
    "automation"
  ],
  "author": "@ratiofu",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.4",
    "puppeteer-core": "24.17.0",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "@vitest/coverage-v8": "3.2.4",
    "concurrently": "9.2.0",
    "esbuild": "0.25.9",
    "nodemon": "3.1.10",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}