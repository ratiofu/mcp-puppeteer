{
  "name": "puppeteer-mcp",
  "version": "1.0.0",
  "description": "MCP server for controlling Chrome via Puppeteer",
  "repository": {
    "type": "git",
    "url": "https://github.com/ratiofu/mcp-puppeteer"
  },
  "main": "dist/index.js",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run typecheck && rm -rf dist && node esbuild.config.js",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "pnpm run build && pnpm run start",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "puppeteer",
    "chrome"
  ],
  "author": "@ratiofu",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.17.3",
    "express": "5.1.0",
    "puppeteer-core": "24.17.0",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "24.3.0",
    "esbuild": "0.25.9",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}